# OPTION 1: BREVO REST API (RECOMMENDED - 100% Firewall-Proof over HTTPS Port 443)
# 1. Sign up at https://www.brevo.com/ (300 free emails/day, no credit card required)
# 2. Go to SMTP & API -> API Keys -> Generate a new API Key
# 3. Paste key below:
BREVO_API_KEY=xkeysib-your-brevo-api-key
CONTACT_RECEIVER_EMAIL=urvagandhi24@gmail.com

# -----------------------------------------------------------------------------

# OPTION 2: BREVO SMTP RELAY (Port 587 - Fully supported on Vercel)
# 1. Go to Brevo Dashboard -> SMTP & API -> SMTP
# 2. Copy SMTP Key and set variables below:
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login-email@gmail.com
SMTP_PASS=xsmtpsib-your-brevo-smtp-key

# -----------------------------------------------------------------------------
# MAIL TRACKER & RECRUITMENT OUTREACH TELEMETRY
# -----------------------------------------------------------------------------

# Telegram Bot Alerts (D1)
# 1. Create a bot with @BotFather to obtain the token
# 2. Retrieve your user/chat ID from @userinfobot
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"
TELEGRAM_CHAT_ID="123456789"

# Upstash Redis Datastore over HTTPS REST (D2)
# Create a free serverless Redis database at https://console.upstash.com/
UPSTASH_REDIS_KV_REST_API_URL="https://your-database-name.upstash.io"
UPSTASH_REDIS_KV_REST_API_TOKEN="your_upstash_redis_rest_token"
UPSTASH_REDIS_KV_REST_API_READ_ONLY_TOKEN="your_upstash_redis_readonly_token"
UPSTASH_REDIS_KV_URL="rediss://default:your_token@your-database-name.upstash.io:6379"
UPSTASH_REDIS_REDIS_URL="rediss://default:your_token@your-database-name.upstash.io:6379"

# API Authentication & Cryptographic Signing Secrets
# Generate 32-byte random hex keys: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used for Bearer token auth in /api/mail/register, /api/mail/void and /api/mail/status
MAIL_API_SECRET="your_32_byte_hex_mail_api_secret"

# Used for HMAC-SHA256 signature verification in tracking tokens (<payload>.<signature>)
MAIL_SIGNING_SECRET="your_32_byte_hex_signing_secret"

# Outreach Telemetry Dashboard Access (D4)
# Secret passkey required to access /portal/outreach-telemetry
DASHBOARD_SECRET_KEY="your_secure_passkey_or_hex_secret"

# Secret used to sign HttpOnly admin session cookies (outreach_admin_session)
PORTAL_SESSION_SECRET="your_32_byte_hex_session_secret"
