# OPTION 2: BREVO SMTP RELAY (Port 587 - Fully supported on Vercel)
# 1. Go to Brevo Dashboard -> SMTP & API -> SMTP
# 2. Copy SMTP Key and set variables below:
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login-email@gmail.com
SMTP_PASS=xsmtpsib-your-brevo-smtp-key
